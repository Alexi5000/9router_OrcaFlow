{
  "name": "orcaflow",
  "version": "0.5.112",
  "description": "OrcaFlow \u2014 AI Router by TechTide AI (based on 9Router)",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 20128",
    "dev:webpack": "next dev --webpack --port 20127",
    "build": "node scripts/verify-braces.cjs && node scripts/verify-forge.cjs && NODE_ENV=production next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "NODE_ENV=production node custom-server.js --port 20128",
    "dev:bun": "bun --bun next dev --webpack --port 20128",
    "build:bun": "NODE_ENV=production bun --bun next build --webpack",
    "start:bun": "NODE_ENV=production bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli",
    "deploy:prod": "npm run test:deployment && node scripts/redeploy-production.cjs",
    "validate:deepseek-route": "npm run test:deployment && node scripts/validate-deepseek-route.mjs",
    "security:backport": "node scripts/verify-braces.cjs",
    "test:unit": "vitest run --root tests --config vitest.config.js unit/ --exclude '**/*.live.test.js'",
    "test:deployment": "vitest run --root tests --config vitest.config.js deployment"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.2.9",
    "@node-saml/node-saml": "^5.1.0",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "confbox": "^0.2.4",
    "enquirer": "^2.4.1",
    "jose": "^6.2.12",
    "marked": "^18.0.1",
    "material-symbols": "^0.44.6",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.2",
    "node-forge": "file:vendor/node-forge-1.4.0.tgz",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.14.1",
    "undici": "^7.30.1",
    "uuid": "^13.0.2",
    "zustand": "^5.0.15",
    "@playwright/test": "^1.64.1",
    "express": "^5.3.0",
    "fs": "0.0.1-security",
    "http-proxy-middleware": "^3.0.7",
    "lowdb": "^7.0.1",
    "react-is": "^16.13.1",
    "selfsigned": "^5.5.0",
    "styled-jsx": "^5.1.7"
  },
  "optionalDependencies": {
    "@aws-sdk/credential-providers": "^3.1135.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.11.1",
    "ws": "^8.18.0"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools \u2014 sql.js is used as fallback at runtime",
  "comment_aws_sdk_credential_providers": "kept in optionalDependencies (npm still installs these by default) and imported lazily in shared/awsCredentials.js \u2014 only AWS Bedrock connections using profile/SSO mode need it; static accessKeyId/secretAccessKey connections never load it",
  "comment_playwright_core": "devDependency only (keeps end-user installs small); open-sse/services/lazyRuntime.js downloads it + wreq-js on first use into <DATA_DIR>/runtime. playwright-core ships no browser binaries (run `npx playwright-core install chromium` or point OBSCURA_CDP_ENDPOINT/cloakbrowser at a stealth engine)",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "wreq-js": "^3.2.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "braces": "file:vendor/braces-3.0.3.tgz"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "ip-address": "^10.7.4",
    "braces": "file:vendor/braces-3.0.3.tgz",
    "node-forge": "file:vendor/node-forge-1.4.0.tgz"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "ip-address": "^10.7.4",
      "braces": "file:vendor/braces-3.0.3.tgz",
      "node-forge": "file:vendor/node-forge-1.4.0.tgz"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
