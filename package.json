{
  "name": "orcaflow",
  "version": "0.3.54",
  "description": "OrcaFlow \u2014 AI Router by TechTide AI (based on 9Router)",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 20128",
    "build": "node scripts/verify-braces.cjs && node scripts/verify-forge.cjs && NODE_ENV=production next build --webpack",
    "start": "NODE_ENV=production next start",
    "deploy:prod": "npm run test:deployment && node scripts/redeploy-production.cjs",
    "validate:deepseek-route": "npm run test:deployment && node scripts/validate-deepseek-route.mjs",
    "dev:bun": "bun --bun next dev --webpack --port 20128",
    "build:bun": "NODE_ENV=production bun --bun next build --webpack",
    "start:bun": "NODE_ENV=production bun ./.next/standalone/server.js",
    "security:backport": "node scripts/verify-braces.cjs",
    "test:unit": "vitest run --root tests --config vitest.config.js unit",
    "test:deployment": "vitest run --root tests --config vitest.config.js deployment"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.64.1",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "confbox": "^0.2.4",
    "express": "^5.3.0",
    "fs": "0.0.1-security",
    "http-proxy-middleware": "^3.0.7",
    "jose": "^6.2.12",
    "lowdb": "^7.0.1",
    "monaco-editor": "^0.55.1",
    "next": "^16.4.2",
    "node-forge": "file:vendor/node-forge-1.4.0.tgz",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "recharts": "^3.10.1",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^8.0.5",
    "styled-jsx": "^5.1.7",
    "undici": "^7.30.1",
    "uuid": "^13.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "braces": "file:vendor/braces-3.0.3.tgz"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.16",
      "braces": "file:vendor/braces-3.0.3.tgz",
      "node-forge": "file:vendor/node-forge-1.4.0.tgz"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
