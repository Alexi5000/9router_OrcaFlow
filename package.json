{
  "name": "orcaflow",
  "version": "0.3.54",
  "description": "OrcaFlow - AI Router by TechTide AI (based on 9Router)",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "next dev --webpack --port 20128",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "test": "pnpm exec vitest run --config tests/vitest.config.js unit",
    "test:edge": "pnpm exec vitest run --config tests/vitest.config.js edge-cases",
    "test:e2e": "pnpm exec vitest run --config tests/vitest.config.js e2e",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "verify:artifacts": "node scripts/verify-tracked-artifacts.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:artifacts",
    "deploy:prod": "node scripts/redeploy-production.cjs",
    "validate:deepseek-route": "node scripts/validate-deepseek-route.mjs",
    "dev:bun": "bun --bun next dev --webpack --port 20128",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/server.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "confbox": "^0.2.4",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^6.1.3",
    "lowdb": "^7.0.1",
    "monaco-editor": "^0.55.1",
    "next": "^16.2.1",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "recharts": "^3.7.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^8.0.5",
    "styled-jsx": "^5.1.6",
    "undici": "^7.24.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "19.2.14",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.3.2",
      "flatted": "^3.4.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
